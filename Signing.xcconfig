// Shared signing defaults for Debug builds and Release archives.
// Use installed certificate/private-key identities without account-managed provisioning.
// Developer ID distribution signing is selected separately when exporting an archive.
// Doc: Sentient OS macOS/Updates/Documentation - Auto-Update (Sparkle) & Release Pipeline.md

DEVELOPMENT_TEAM = YJ8AZR3G5Q
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Development

// Machine-specific certificate fingerprints and contributor team overrides stay gitignored.
// Keep founders on the shared team; a local CODE_SIGN_IDENTITY can select an exact certificate.
// Change this file or Signing.local.xcconfig, never Xcode's Signing & Capabilities dropdown.
#include? "Signing.local.xcconfig"
