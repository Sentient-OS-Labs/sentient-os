{
  "name": "sentient-doubletap-relay",
  "private": true,
  "type": "module",
  "description": "Stateless Cloudflare Worker that relays Double Tap requests to OpenAI with Sentient's key, per-user caps, and no data at rest.",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.135.0"
  },
  "allowScripts": {
    "workerd@1.20260918.1": true
  }
}
